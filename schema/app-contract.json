{
  "version": 1,
  "stack": {
    "framework": "nextjs-app-router",
    "language": "typescript",
    "styling": "tailwindcss",
    "icons": "lucide-react",
    "backend": "nextjs-route-handlers",
    "database": "supabase-postgres",
    "auth": "supabase-google-oauth",
    "supabaseSsrPackage": "@supabase/ssr"
  },
  "principles": [
    "figma_atomic_design_is_source_of_truth",
    "figma_tokens_are_source_of_truth",
    "pages_use_template_components",
    "server_authoritative_clue_progression",
    "server_authoritative_answer_checking",
    "daily_publication_has_user_scoped_attempts",
    "daily_success_streak_has_user_scoped_results",
    "do_not_expose_answer_before_terminal_result",
    "do_not_expose_locked_clues",
    "do_not_read_puzzles_directly_from_browser_supabase_client",
    "anonymous_play_allowed",
    "anonymous_attempt_claimed_after_signin",
    "post_oauth_nickname_required",
    "ranking_requires_authenticated_profile",
    "email_is_never_public",
    "service_role_key_is_server_only",
    "custom_game_links_are_anonymous_playable",
    "anonymous_nickname_ranking_allowed"
  ],
  "mvpScope": {
    "included": [
      "today_puzzle",
      "result",
      "daily_ranking",
      "google_sign_in",
      "nickname_setup",
      "daily_winner_message",
      "daily_puzzle_feedback",
      "group_ranking_full_flow",
      "streak_ranking",
      "custom_game_creation",
      "custom_game_play",
      "custom_game_ranking",
      "anonymous_nickname_daily_ranking"
    ],
    "deferred": [
      "admin_review_web_ui",
      "season_ranking",
      "moderation_ui",
      "custom_game_ai_quality_check",
      "custom_game_creator_accounts",
      "custom_game_global_ranking"
    ]
  },
  "frontend": {
    "pages": [
      {
        "name": "Today Puzzle",
        "path": "/",
        "file": "src/app/page.tsx",
        "auth": "optional",
        "states": [
          "loading",
          "no_puzzle",
          "ready",
          "playing",
          "solved",
          "failed",
          "already_completed"
        ],
        "designScreen": "Today Puzzle"
      },
      {
        "name": "Result",
        "path": "/result",
        "file": "src/app/result/page.tsx",
        "auth": "optional",
        "states": [
          "solved",
          "failed",
          "ranking_cta",
          "share_ready"
        ],
        "designScreens": [
          "Solved Result",
          "Failed Result"
        ]
      },
      {
        "name": "Daily Ranking",
        "path": "/ranking",
        "file": "src/app/ranking/page.tsx",
        "auth": "optional",
        "states": [
          "loading",
          "ready",
          "empty",
          "privacy_prompt",
          "feedback_locked",
          "feedback_ready",
          "group_ready",
          "group_join_required",
          "streak_ready"
        ],
        "designScreens": [
          "Daily Ranking",
          "Group Ranking",
          "Ranking Empty State"
        ]
      },
      {
        "name": "Sign In",
        "path": "/signin",
        "file": "src/app/signin/page.tsx",
        "auth": "guest",
        "states": [
          "ready",
          "oauth_pending",
          "oauth_error"
        ],
        "designScreen": "Sign In"
      },
      {
        "name": "Nickname Setup",
        "path": "/nickname",
        "file": "src/app/nickname/page.tsx",
        "auth": "required",
        "states": [
          "ready",
          "validating",
          "invalid",
          "saving"
        ],
        "designScreen": "Nickname Setup"
      },
      {
        "name": "Custom Game Create",
        "path": "/custom/new",
        "file": "src/app/custom/new/page.tsx",
        "auth": "optional",
        "states": [
          "ready",
          "validating",
          "created"
        ]
      },
      {
        "name": "Custom Game Play",
        "path": "/custom/[slug]",
        "file": "src/app/custom/[slug]/page.tsx",
        "auth": "optional",
        "states": [
          "loading",
          "ready",
          "playing",
          "solved",
          "failed",
          "hidden",
          "not_found"
        ]
      },
      {
        "name": "Custom Game Ranking",
        "path": "/custom/[slug]/ranking",
        "file": "src/app/custom/[slug]/ranking/page.tsx",
        "auth": "optional",
        "states": [
          "ready",
          "empty",
          "not_found"
        ]
      },
      {
        "name": "Custom Game Manage",
        "path": "/custom/manage/[token]",
        "file": "src/app/custom/manage/[token]/page.tsx",
        "auth": "optional",
        "states": [
          "ready",
          "hidden",
          "deleted",
          "not_found"
        ]
      }
    ],
    "componentLayers": {
      "atoms": [
        "Button",
        "GoogleSignInButton",
        "IconButton",
        "TextInput",
        "Badge",
        "ClueNumber",
        "StatusDot",
        "Divider"
      ],
      "molecules": [
        "ClueRow",
        "GuessInputGroup",
        "ScoreBadge",
        "FeedbackMessage",
        "AuthStatusMessage",
        "ShareActionGroup",
        "RankingRow",
        "LeaderboardTabs",
        "GroupInviteCard"
      ],
      "organisms": [
        "PuzzleBoard",
        "ResultPanel",
        "SignInPanel",
        "NicknamePanel",
        "GameHeader",
        "AdminCandidateCard",
        "AdminReviewPanel",
        "LeaderboardPanel",
        "RankingPrivacyPrompt"
      ],
      "templates": [
        "DailyPuzzleTemplate",
        "AuthTemplate",
        "ResultTemplate",
        "AdminReviewTemplate",
        "RankingTemplate"
      ]
    },
    "figmaParity": {
      "sourceFiles": [
        "design/components.json",
        "design/screens.json",
        "design/tokens.json"
      ],
      "componentRoot": "src/components",
      "globalsCss": "src/app/globals.css",
      "requiredCssVariablesFromTokens": true,
      "pagesMustUseTemplates": true,
      "layoutNumbers": {
        "mobileFrameWidth": 390,
        "screenPaddingX": 32,
        "panelWidth": 326,
        "panelPaddingX": 24,
        "panelContentWidth": 278,
        "buttonHeight": 52,
        "textInputHeight": 56,
        "rankingRowHeight": 64
      }
    },
    "forbiddenClientPatterns": [
      "from('puzzles')",
      "SUPABASE_SERVICE_ROLE_KEY",
      "process.env.SUPABASE_SERVICE_ROLE_KEY"
    ]
  },
  "backend": {
    "playModel": {
      "dailyPublicationScope": "one_published_puzzle_per_kst_date",
      "activePublicationWindowKst": "17:00_to_next_day_17:00",
      "attemptScope": "publication_id+(user_id|anonymous_session_id)",
      "allAuthenticatedUsersCanPlaySamePublication": true,
      "allAnonymousSessionsCanPlaySamePublication": true,
      "anonymousAttemptClaimedAfterSignin": true,
      "terminalAnonymousAttemptPreventsSigninReplay": true,
      "leaderboardDoesNotLockPlay": true,
      "winnerDoesNotLockPlay": true,
      "oneRankedEntryPerUserPublication": true,
      "oneDailyResultPerUserPublication": true,
      "streakProjectionScope": "user_id",
      "anonymousNicknameRankingAllowed": true
    },
    "routeHandlers": [
      {
        "name": "OAuth Callback",
        "method": "GET",
        "path": "/auth/callback",
        "file": "src/app/auth/callback/route.ts",
        "auth": "oauth-callback"
      },
      {
        "name": "Today",
        "method": "GET",
        "path": "/api/today",
        "file": "src/app/api/today/route.ts",
        "auth": "optional",
        "mustNotExpose": [
          "answer",
          "aliases",
          "rationale",
          "locked_clues",
          "submitted_answer",
          "normalized_answer"
        ]
      },
      {
        "name": "Start Attempt",
        "method": "POST",
        "path": "/api/attempts/start",
        "file": "src/app/api/attempts/start/route.ts",
        "auth": "optional",
        "serverAuthoritativeFields": [
          "started_at",
          "user_id",
          "anonymous_session_id"
        ]
      },
      {
        "name": "Reveal Clue",
        "method": "POST",
        "path": "/api/attempts/reveal",
        "file": "src/app/api/attempts/reveal/route.ts",
        "auth": "optional",
        "mustNotExpose": [
          "answer",
          "aliases",
          "rationale",
          "locked_clues"
        ]
      },
      {
        "name": "Submit Attempt",
        "method": "POST",
        "path": "/api/attempts/submit",
        "file": "src/app/api/attempts/submit/route.ts",
        "auth": "optional",
        "serverAuthoritativeFields": [
          "is_correct",
          "used_clue_count",
          "elapsed_ms",
          "is_ranked",
          "rank_status"
        ]
      },
      {
        "name": "Daily Leaderboard",
        "method": "GET",
        "path": "/api/leaderboard/daily",
        "file": "src/app/api/leaderboard/daily/route.ts",
        "auth": "optional",
        "order": [
          {
            "column": "used_clue_count",
            "direction": "asc"
          },
          {
            "column": "elapsed_ms",
            "direction": "asc"
          },
          {
            "column": "submitted_at",
            "direction": "asc"
          }
        ],
        "mustNotExpose": [
          "email",
          "submitted_answer",
          "normalized_answer",
          "device_hash",
          "ip_hash",
          "user_agent_hash"
        ]
      },
      {
        "name": "Streak Leaderboard",
        "method": "GET",
        "path": "/api/leaderboard/streak",
        "file": "src/app/api/leaderboard/streak/route.ts",
        "auth": "optional",
        "order": [
          {
            "column": "current_streak",
            "direction": "desc"
          },
          {
            "column": "last_success_publish_date_kst",
            "direction": "desc"
          },
          {
            "column": "longest_streak",
            "direction": "desc"
          },
          {
            "column": "total_success_count",
            "direction": "desc"
          }
        ],
        "mustNotExpose": [
          "email",
          "answer",
          "aliases",
          "rationale",
          "submitted_answer",
          "normalized_answer",
          "device_hash",
          "ip_hash",
          "user_agent_hash"
        ]
      },
      {
        "name": "Group Leaderboard",
        "method": "GET",
        "path": "/api/leaderboard/group",
        "file": "src/app/api/leaderboard/group/route.ts",
        "auth": "optional",
        "requires": [
          "invite_code"
        ],
        "order": [
          {
            "column": "used_clue_count",
            "direction": "asc"
          },
          {
            "column": "elapsed_ms",
            "direction": "asc"
          },
          {
            "column": "submitted_at",
            "direction": "asc"
          }
        ],
        "mustNotExpose": [
          "email",
          "submitted_answer",
          "normalized_answer",
          "device_hash",
          "ip_hash",
          "user_agent_hash"
        ]
      },
      {
        "name": "Create Ranking Group",
        "method": "POST",
        "path": "/api/groups",
        "file": "src/app/api/groups/route.ts",
        "auth": "required",
        "requires": [
          "profile",
          "active_publication"
        ]
      },
      {
        "name": "Join Ranking Group",
        "method": "POST",
        "path": "/api/groups/join",
        "file": "src/app/api/groups/join/route.ts",
        "auth": "required",
        "requires": [
          "profile",
          "invite_code",
          "active_publication"
        ]
      },
      {
        "name": "Current Winner Message",
        "method": "GET",
        "path": "/api/winner-message/current",
        "file": "src/app/api/winner-message/current/route.ts",
        "auth": "optional",
        "publicFields": [
          "nickname_snapshot",
          "message",
          "visible_until"
        ]
      },
      {
        "name": "Write Winner Message",
        "method": "POST",
        "path": "/api/winner-message",
        "file": "src/app/api/winner-message/route.ts",
        "auth": "required",
        "requires": [
          "profile",
          "daily_rank_1"
        ],
        "maxMessageLength": 100
      },
      {
        "name": "Daily Puzzle Feedback",
        "method": "GET",
        "path": "/api/puzzle-feedback/daily",
        "file": "src/app/api/puzzle-feedback/daily/route.ts",
        "auth": "optional",
        "requires": [
          "profile",
          "completed_attempt"
        ],
        "requiresCompletedAttempt": true,
        "publicFields": [
          "nickname_snapshot",
          "reaction",
          "comment",
          "created_at"
        ],
        "mustNotExpose": [
          "email",
          "answer",
          "aliases",
          "rationale",
          "submitted_answer",
          "normalized_answer",
          "device_hash",
          "ip_hash",
          "user_agent_hash"
        ]
      },
      {
        "name": "Write Puzzle Feedback",
        "method": "POST",
        "path": "/api/puzzle-feedback",
        "file": "src/app/api/puzzle-feedback/route.ts",
        "auth": "required",
        "requires": [
          "profile",
          "completed_attempt"
        ],
        "requiresCompletedAttempt": true,
        "maxCommentLength": 140,
        "allowedReactions": [
          "easy",
          "good",
          "hard",
          "tricky",
          "fun"
        ]
      },
      {
        "name": "Create Custom Game",
        "method": "POST",
        "path": "/api/custom-games",
        "file": "src/app/api/custom-games/route.ts",
        "auth": "optional",
        "requires": [
          "answer",
          "clues"
        ]
      },
      {
        "name": "Custom Game State",
        "method": "GET",
        "path": "/api/custom-games/[slug]",
        "file": "src/app/api/custom-games/[slug]/route.ts",
        "auth": "optional",
        "mustNotExpose": [
          "answer",
          "aliases",
          "locked_clues",
          "submitted_answer",
          "normalized_answer"
        ]
      },
      {
        "name": "Start Custom Game",
        "method": "POST",
        "path": "/api/custom-games/[slug]/start",
        "file": "src/app/api/custom-games/[slug]/start/route.ts",
        "auth": "optional"
      },
      {
        "name": "Reveal Custom Game Clue",
        "method": "POST",
        "path": "/api/custom-games/[slug]/reveal",
        "file": "src/app/api/custom-games/[slug]/reveal/route.ts",
        "auth": "optional",
        "mustNotExpose": [
          "answer",
          "aliases",
          "locked_clues"
        ]
      },
      {
        "name": "Submit Custom Game Guess",
        "method": "POST",
        "path": "/api/custom-games/[slug]/submit",
        "file": "src/app/api/custom-games/[slug]/submit/route.ts",
        "auth": "optional",
        "serverAuthoritativeFields": [
          "is_correct",
          "used_clue_count",
          "elapsed_ms"
        ]
      },
      {
        "name": "Custom Game Ranking",
        "method": "GET",
        "path": "/api/custom-games/[slug]/ranking",
        "file": "src/app/api/custom-games/[slug]/ranking/route.ts",
        "auth": "optional",
        "order": [
          {
            "column": "used_clue_count",
            "direction": "asc"
          },
          {
            "column": "elapsed_ms",
            "direction": "asc"
          },
          {
            "column": "submitted_at",
            "direction": "asc"
          }
        ],
        "mustNotExpose": [
          "email",
          "submitted_answer",
          "normalized_answer",
          "device_hash",
          "ip_hash",
          "user_agent_hash"
        ]
      },
      {
        "name": "Register Custom Game Ranking",
        "method": "POST",
        "path": "/api/custom-games/[slug]/ranking",
        "file": "src/app/api/custom-games/[slug]/ranking/route.ts",
        "auth": "optional",
        "requires": [
          "nickname"
        ]
      },
      {
        "name": "Report Custom Game",
        "method": "POST",
        "path": "/api/custom-games/[slug]/report",
        "file": "src/app/api/custom-games/[slug]/report/route.ts",
        "auth": "optional"
      },
      {
        "name": "Read Custom Game Admin",
        "method": "GET",
        "path": "/api/custom-games/admin/[token]",
        "file": "src/app/api/custom-games/admin/[token]/route.ts",
        "auth": "optional"
      },
      {
        "name": "Update Custom Game Admin",
        "method": "POST",
        "path": "/api/custom-games/admin/[token]",
        "file": "src/app/api/custom-games/admin/[token]/route.ts",
        "auth": "optional"
      }
    ],
    "forbiddenPublicResponseFields": [
      "email",
      "answer",
      "aliases",
      "rationale",
      "submitted_answer",
      "normalized_answer",
      "device_hash",
      "ip_hash",
      "user_agent_hash"
    ],
    "rankingOrder": [
      {
        "column": "used_clue_count",
        "direction": "asc"
      },
      {
        "column": "elapsed_ms",
        "direction": "asc"
      },
      {
        "column": "submitted_at",
        "direction": "asc"
      }
    ],
    "streakRankingOrder": [
      {
        "column": "current_streak",
        "direction": "desc"
      },
      {
        "column": "last_success_publish_date_kst",
        "direction": "desc"
      },
      {
        "column": "longest_streak",
        "direction": "desc"
      },
      {
        "column": "total_success_count",
        "direction": "desc"
      }
    ],
    "customGames": {
      "anonymousCreateAllowed": true,
      "anonymousPlayAllowed": true,
      "creatorInput": [
        "answer",
        "clues"
      ],
      "clueCount": 5,
      "immutableAfterCreate": true,
      "adminActions": [
        "hide",
        "delete"
      ],
      "firstRecordOnly": true
    }
  },
  "environment": {
    "required": [
      "NEXT_PUBLIC_SUPABASE_URL",
      "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
      "SUPABASE_SERVICE_ROLE_KEY"
    ],
    "serverOnly": [
      "SUPABASE_SERVICE_ROLE_KEY"
    ],
    "publicAllowed": [
      "NEXT_PUBLIC_SUPABASE_URL",
      "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY"
    ]
  },
  "validation": {
    "beforeImplementation": [
      "npm run db:check",
      "npm run figma:layout:contract",
      "npm run figma:composition:contract",
      "npm run app:contract"
    ],
    "beforeMerge": [
      "npm run db:check",
      "npm run figma:layout:contract",
      "npm run figma:composition:contract",
      "npm run app:check"
    ],
    "implementationRequiredCommand": "npm run app:implementation:check"
  }
}
