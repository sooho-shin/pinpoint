{
  "version": 1,
  "stack": {
    "framework": "nextjs-app-router",
    "language": "typescript",
    "styling": "tailwindcss",
    "icons": "lucide-react",
    "backend": "nextjs-route-handlers",
    "database": "supabase-postgres",
    "auth": "supabase-google-oauth",
    "supabaseSsrPackage": "@supabase/ssr"
  },
  "principles": [
    "server_authoritative_clue_progression",
    "server_authoritative_answer_checking",
    "do_not_expose_answer_before_terminal_result",
    "do_not_expose_locked_clues",
    "do_not_read_puzzles_directly_from_browser_supabase_client",
    "anonymous_play_allowed",
    "ranking_requires_authenticated_profile",
    "email_is_never_public",
    "service_role_key_is_server_only"
  ],
  "mvpScope": {
    "included": [
      "today_puzzle",
      "result",
      "daily_ranking",
      "google_sign_in",
      "nickname_setup",
      "daily_winner_message"
    ],
    "deferred": [
      "group_ranking_full_flow",
      "admin_review_web_ui",
      "season_ranking",
      "puzzle_generation_ui",
      "moderation_ui"
    ]
  },
  "frontend": {
    "pages": [
      {
        "name": "Today Puzzle",
        "path": "/",
        "file": "src/app/page.tsx",
        "auth": "optional",
        "states": ["loading", "no_puzzle", "ready", "playing", "solved", "failed", "already_completed"],
        "designScreen": "Today Puzzle"
      },
      {
        "name": "Result",
        "path": "/result",
        "file": "src/app/result/page.tsx",
        "auth": "optional",
        "states": ["solved", "failed", "ranking_cta", "share_ready"],
        "designScreens": ["Solved Result", "Failed Result"]
      },
      {
        "name": "Daily Ranking",
        "path": "/ranking",
        "file": "src/app/ranking/page.tsx",
        "auth": "optional",
        "states": ["loading", "ready", "empty", "privacy_prompt"],
        "designScreens": ["Daily Ranking", "Ranking Empty State"]
      },
      {
        "name": "Sign In",
        "path": "/signin",
        "file": "src/app/signin/page.tsx",
        "auth": "guest",
        "states": ["ready", "oauth_pending", "oauth_error"],
        "designScreen": "Sign In"
      },
      {
        "name": "Nickname Setup",
        "path": "/nickname",
        "file": "src/app/nickname/page.tsx",
        "auth": "required",
        "states": ["ready", "validating", "invalid", "saving"],
        "designScreen": "Nickname Setup"
      }
    ],
    "componentLayers": {
      "atoms": ["Button", "GoogleSignInButton", "IconButton", "TextInput", "Badge", "ClueNumber", "StatusDot", "Divider"],
      "molecules": ["ClueRow", "GuessInputGroup", "ScoreBadge", "FeedbackMessage", "AuthStatusMessage", "ShareActionGroup", "RankingRow", "LeaderboardTabs"],
      "organisms": ["PuzzleBoard", "ResultPanel", "SignInPanel", "NicknamePanel", "GameHeader", "LeaderboardPanel", "RankingPrivacyPrompt"],
      "templates": ["DailyPuzzleTemplate", "AuthTemplate", "ResultTemplate", "RankingTemplate"]
    },
    "forbiddenClientPatterns": [
      "from('puzzles')",
      "SUPABASE_SERVICE_ROLE_KEY",
      "process.env.SUPABASE_SERVICE_ROLE_KEY"
    ]
  },
  "backend": {
    "routeHandlers": [
      {
        "name": "OAuth Callback",
        "method": "GET",
        "path": "/auth/callback",
        "file": "src/app/auth/callback/route.ts",
        "auth": "oauth-callback"
      },
      {
        "name": "Today",
        "method": "GET",
        "path": "/api/today",
        "file": "src/app/api/today/route.ts",
        "auth": "optional",
        "mustNotExpose": ["answer", "aliases", "rationale", "locked_clues", "submitted_answer", "normalized_answer"]
      },
      {
        "name": "Start Attempt",
        "method": "POST",
        "path": "/api/attempts/start",
        "file": "src/app/api/attempts/start/route.ts",
        "auth": "optional",
        "serverAuthoritativeFields": ["started_at", "anonymous_session_id", "user_id"]
      },
      {
        "name": "Reveal Clue",
        "method": "POST",
        "path": "/api/attempts/reveal",
        "file": "src/app/api/attempts/reveal/route.ts",
        "auth": "optional",
        "mustNotExpose": ["answer", "aliases", "rationale", "locked_clues"]
      },
      {
        "name": "Submit Attempt",
        "method": "POST",
        "path": "/api/attempts/submit",
        "file": "src/app/api/attempts/submit/route.ts",
        "auth": "optional",
        "serverAuthoritativeFields": ["is_correct", "used_clue_count", "elapsed_ms", "is_ranked", "rank_status"]
      },
      {
        "name": "Daily Leaderboard",
        "method": "GET",
        "path": "/api/leaderboard/daily",
        "file": "src/app/api/leaderboard/daily/route.ts",
        "auth": "optional",
        "order": [
          { "column": "used_clue_count", "direction": "asc" },
          { "column": "elapsed_ms", "direction": "asc" },
          { "column": "submitted_at", "direction": "asc" }
        ],
        "mustNotExpose": ["email", "submitted_answer", "normalized_answer", "device_hash", "ip_hash", "user_agent_hash"]
      },
      {
        "name": "Current Winner Message",
        "method": "GET",
        "path": "/api/winner-message/current",
        "file": "src/app/api/winner-message/current/route.ts",
        "auth": "optional",
        "publicFields": ["nickname_snapshot", "message", "visible_until"]
      },
      {
        "name": "Write Winner Message",
        "method": "POST",
        "path": "/api/winner-message",
        "file": "src/app/api/winner-message/route.ts",
        "auth": "required",
        "requires": ["profile", "daily_rank_1"],
        "maxMessageLength": 100
      }
    ],
    "forbiddenPublicResponseFields": [
      "email",
      "answer",
      "aliases",
      "rationale",
      "submitted_answer",
      "normalized_answer",
      "device_hash",
      "ip_hash",
      "user_agent_hash"
    ],
    "rankingOrder": [
      { "column": "used_clue_count", "direction": "asc" },
      { "column": "elapsed_ms", "direction": "asc" },
      { "column": "submitted_at", "direction": "asc" }
    ]
  },
  "environment": {
    "required": [
      "NEXT_PUBLIC_SUPABASE_URL",
      "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
      "SUPABASE_SERVICE_ROLE_KEY"
    ],
    "serverOnly": ["SUPABASE_SERVICE_ROLE_KEY"],
    "publicAllowed": ["NEXT_PUBLIC_SUPABASE_URL", "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY"]
  },
  "validation": {
    "beforeImplementation": ["npm run db:check", "npm run figma:layout:contract", "npm run figma:composition:contract", "npm run app:contract"],
    "beforeMerge": ["npm run db:check", "npm run figma:layout:contract", "npm run figma:composition:contract", "npm run app:check"],
    "implementationRequiredCommand": "npm run app:implementation:check"
  }
}
